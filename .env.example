# Copia este archivo como .env y completa los valores.

# Seguridad
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Bot de Telegram (lo entrega @BotFather). Opcional: también puedes
# guardarlo desde Configuración en el panel; ese valor tiene prioridad.
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT=60

# Zona horaria usada por el panel y el programador.
# Etc/GMT+5 = Cuba sin horario de verano (UTC-05:00), coincide con la hora local.
TIME_ZONE=Etc/GMT+5

# Programador: cada cuántos segundos revisa publicaciones pendientes
SCHEDULER_INTERVAL=10
# Si el programador no da señales en estos segundos, el panel lo marca caído
WORKER_STALE_SECONDS=90
